# ---------------------------------------------------------------------------
# Ropana Wound Care - environment template
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# MongoDB (MongoDB Atlas connection string, including the database name)
MONGODB_URI=PASTE_YOUR_MONGODB_CONNECTION_STRING_HERE

# Authentication - must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_HERE

# Admin seed account (used only by `npm run seed:admin`)
ADMIN_NAME=PASTE_ADMIN_DISPLAY_NAME_HERE
ADMIN_EMAIL=PASTE_ADMIN_EMAIL_HERE
ADMIN_PASSWORD=PASTE_A_STRONG_ADMIN_PASSWORD_HERE


# Business details (public, safe to expose to the browser)
NEXT_PUBLIC_BUSINESS_NAME=Ropana Wound Care
NEXT_PUBLIC_BUSINESS_EMAIL=ropanawoundcare@gmail.com
NEXT_PUBLIC_BUSINESS_PHONE=2174042055
NEXT_PUBLIC_BUSINESS_FAX=9413400789
NEXT_PUBLIC_SERVICE_AREA=DFW Area
